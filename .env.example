# ==========================================
# VAPUR (FERRYFLOW) ENVIRONMENT CONFIGURATION
# ==========================================

# [FRONTEND / WEB]  — Next.js uygulaması
# İstemci tarafında kullanılan backend adresleri
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
# Mapbox token (opsiyonel; yoksa offline grid/leaflet fallback kullanılır)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# [BACKEND / API]  — NestJS servisi
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Demo modu: harici AIS/tarife sağlayıcısı olmadan mock provider çalışır
ENABLE_DEMO_MODE="true"

# JWT sırları — API auth kullanılıyorsa yerelde de üretin; üretimde zorunludur
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# İsteğe bağlı paylaşımlı KV: web telemetrisi ve dağıtık hız sınırı için
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# [DATABASE]
# API tek bir SQLite dosyası kullanır (bkz. apps/api/prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# [SEED]
SEED_ADMIN_EMAIL="admin@vapur.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
