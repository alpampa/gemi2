NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# SQLite veritabanı dosyası (API verisi). Üretimde kalıcı bir volume yoluna verin.
DATABASE_URL="file:./dev.db"

# Demo modu: true iken harici AIS/tarife sağlayıcısı olmadan mock provider çalışır.
ENABLE_DEMO_MODE="true"

# JWT sırları — API auth kullanılıyorsa yerelde de üretin; üretimde zorunludur
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed ile oluşturulacak ilk admin (üretimde değiştirin)
SEED_ADMIN_EMAIL="admin@vapur.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
